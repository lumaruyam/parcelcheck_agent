# Copy to .env and fill in. Never commit .env.

# --- Session 1-2: GCP ---
GCP_PROJECT_ID=your-project-id
GCP_REGION=europe-west2
# Bucket name only (gs://bucket-name/ also accepted)
GCP_BUCKET_NAME=your-bucket-name

# --- Session 4: endpoint (fill once deployed) ---
GCP_PROJECT_NUMBER=your-project-number
GCP_ENDPOINT_ID=

# --- Session 5: Langfuse (self-hosted, see infra/langfuse/README.md) ---
LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com   # EU region (infra/langfuse/README.md)

# --- Product: the override switch (governance.md, Session 4) ---
# false = every claim goes to a person, nothing is paid automatically
AUTONOMY_ENABLED=true

# --- Gemini (photo description) ---
# 2.5 Flash was retired on Vertex AI on 20 Oct 2026. 3.8 Flash runs on global, eu or us only.
GEMINI_MODEL=gemini-3.8-flash
GEMINI_LOCATION=eu

# --- Session 6: input guardrail (prompts/input_guardrail.yaml) ---
# false = skip the guardrail (e.g. on a machine without a Google login)
INPUT_GUARDRAIL=true
PROMPT_SOURCE=langfuse   # langfuse = serve the `production` label (falls back to prompts/*.yaml); file = Git only
PROMPT_LABEL=production
# optional overrides of the prompt config (model / location), e.g. for a prompt-drift test
# GUARDRAIL_MODEL=gemini-3.5-flash-lite
# GUARDRAIL_LOCATION=eu
